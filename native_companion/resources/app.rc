#include "resource.h"
#include <winver.h>
#include "app_version.h"

IDI_OJ_PROBLEM_COMPANION ICON "oj_problem_companion.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OJ_VERSION_NUMERIC
 PRODUCTVERSION OJ_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904e4"
    BEGIN
      VALUE "CompanyName", "ZuesHans\0"
      VALUE "FileDescription", "OJ Float problem companion\0"
      VALUE "FileVersion", OJ_VERSION_STRING "\0"
      VALUE "InternalName", "oj_problem_companion\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 ZuesHans. All rights reserved.\0"
      VALUE "OriginalFilename", "oj_problem_companion.exe\0"
      VALUE "ProductName", "OJ Float\0"
      VALUE "ProductVersion", OJ_VERSION_STRING "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
