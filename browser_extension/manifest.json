{
  "manifest_version": 3,
  "name": "OJ Float Problem Importer",
  "version": "1.0.0",
  "description": "Import the current public problem page into OJ Float.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:27121/*"],
  "action": {
    "default_title": "Import to OJ Float",
    "default_popup": "popup.html"
  }
}
